# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Every variable is read by src/dropzone/config.py. Names are prefixed
# DROPZONE_ so they cannot collide with anything else in the environment.

# --- required -------------------------------------------------------------

# HMAC key for session tokens. There is no default: the service refuses to
# start without it, because a default secret would be identical in every
# deployment and would let anyone with the source mint a session for any
# address. Generate a fresh one per environment, never reuse this line:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
DROPZONE_JWT_SECRET=replace-me-with-at-least-32-characters-of-real-entropy

# --- identity of this deployment ------------------------------------------

# Bound into the EIP-4361 message the client signs, and checked on verify.
# Together these are what stop a signature harvested on another site from
# working here, so they must match what the frontend actually serves from.
DROPZONE_DOMAIN=localhost:8000
DROPZONE_URI=http://localhost:8000

# 11155111 = Sepolia. A signature for one chain must not authenticate on another.
DROPZONE_CHAIN_ID=11155111

# --- lifetimes ------------------------------------------------------------

# ISO-8601 durations or seconds. A challenge must outlive a human reading a
# wallet prompt and little else.
DROPZONE_NONCE_TTL=PT5M

# Ceiling on a session. The real expiry is min(now + this, pass expiry).
DROPZONE_SESSION_TTL=PT15M

# --- chain policy ---------------------------------------------------------

# Block depth before a purchase is honoured. 1 grants immediately and accepts
# that a reorg can take it back; raise it to trade latency for finality.
DROPZONE_REQUIRED_CONFIRMATIONS=1
